{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Limit Checker",
  "version": "0.1.0",
  "identifier": "dev.limitrings.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Limit Checker",
        "width": 242,
        "height": 150,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": false,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
